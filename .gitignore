# ---- Your data: never commit (projects, to-dos, notes, focus history, chat, the agent) ----
# data/ holds nestwork.db (every project, to-do, note, reminder, focus session and chat message),
# nestwork.md (the snapshot), agent/ (persona CLAUDE.md, face/body/workspace photos, wardrobe,
# generated pictures, appearance), analysis/ and backups/ (full copies of all of the above).
data/
# Databases anywhere else (e.g. NESTWORK_DB pointed somewhere custom).
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# A snapshot exported somewhere custom (NESTWORK_EXPORT).
nestwork.md

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
# the public C2PA trust anchors (certificates only, no keys) belong in the repo
!nestwork/c2pa_trust_list.pem
*.key

# ---- Machine-specific (absolute paths with your username) ----
# Copy .mcp.json.example to .mcp.json and fill in your paths (Settings → Connect Claude shows them).
.mcp.json
# Generated by the tests with absolute paths.
tests/fake_claude.sh
# Claude Code's per-user settings (launch.json is shared on purpose).
.claude/settings.local.json
.claude/worktrees/

# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- Editors & OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---- Logs ----
*.log
